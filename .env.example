# --- Site ---
# Public URL, used for links inside emails
SITE_URL=https://www.fuselage.co.zw

# --- Email (Resend: https://resend.com) ---
# Leave RESEND_API_KEY empty in development: emails are written to .outbox/ instead of being sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. enquiries@fuselage.co.zw
EMAIL_FROM="Fuselage Resources <enquiries@fuselage.co.zw>"
# Company tenders inbox: receives every tender uploaded in the portal (with documents attached)
# and website enquiries about tenders. Use a company address, not a personal one.
TENDERS_INBOX_EMAIL=fuselageresources@outlook.com
# Optional copy of every uploaded tender (comma-separated), e.g. a Spiritus address
TENDERS_CC=

# Who receives each other enquiry type (defaults to the company inbox)
ROUTE_TENDERS_EMAIL=fuselageresources@outlook.com
ROUTE_QUOTES_EMAIL=fuselageresources@outlook.com
ROUTE_ORDERS_EMAIL=fuselageresources@outlook.com
# Optional: copied on every enquiry so Spiritus has a record (comma-separated)
ENQUIRY_CC=

# --- Client portal (Sofala) ---
# Long random string, e.g. `openssl rand -base64 32`
PORTAL_SESSION_SECRET=change-me-to-a-long-random-string
# Preview sign-in until Sofala accounts exist
PORTAL_DEMO_EMAIL=demo@fuselage.co.zw
PORTAL_DEMO_PASSWORD=sofala-preview

# --- Uploaded documents (Vercel Blob, PRIVATE store) ---
# Added automatically when you connect a Blob store to the project. Without it (local dev) files go to ./.data
BLOB_READ_WRITE_TOKEN=

# --- Sofala alert emails ---
# The Sofala agent (n8n / worker) sends POST /api/sofala/notify with
#   Authorization: Bearer $SOFALA_NOTIFY_SECRET
SOFALA_NOTIFY_SECRET=change-me-too
